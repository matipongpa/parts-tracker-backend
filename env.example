# Copy to .env and fill in. .env is gitignored; never commit real values.

JWT_SECRET=                 # signs JWTs; e.g. `openssl rand -hex 32`
BCRYPT_COST=                # optional

# Auth. The UI keeps the access token in memory and gets a new one from an httpOnly refresh cookie.
# TOKEN_TTL=15m                    # access token lifetime
# REFRESH_TOKEN_TTL=168h           # refresh cookie lifetime = longest login without a password
# CORS_ALLOWED_ORIGINS=http://localhost:4200   # comma-separated UI origins; exact, no "*"
# Cookies default to Secure + SameSite=Lax. Over plain HTTP, Safari will not store a Secure
# cookie, so for local dev set COOKIE_SECURE=false. If the UI and API are on different sites
# in production, set COOKIE_SAMESITE=none (requires COOKIE_SECURE=true).
COOKIE_SECURE=false          # local dev only; remove in production
# COOKIE_SAMESITE=lax
REGISTER_INVITE_CODE=       # shared code required by POST /api/register; unset = registration closed

# Database. Create one on the shared instance with ../postgres-image/scripts/dbctl.sh create partlist
DB_URL=postgres://partlist:<password>@localhost:55433/partlist?sslmode=disable
RUN_MIGRATIONS=true
PORT=8082

# Only for `docker compose up` in this repo: same URL, host.docker.internal instead of localhost.
APP_DB_URL=postgres://partlist:<password>@host.docker.internal:55433/partlist?sslmode=disable
# HOST_PORT=8082

# AI assistant (POST /api/ask) is off unless a key is set.
# AI_PROVIDER=anthropic            # default; uses ANTHROPIC_API_KEY, AI_MODEL optional
# ANTHROPIC_API_KEY=
# AI_PROVIDER=openai-compatible    # OpenAI, Ollama, OpenRouter, tokenme...; needs all three below
# AI_API_KEY=
# AI_BASE_URL=https://api.tokenme.limited/api/v1
# AI_MODEL=deepseek-ai/deepseek-v4-flash-0731
