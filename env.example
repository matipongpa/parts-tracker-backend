JWT_SECRET //jwt secret for sign jwt
BCRYPT_COST // cost to gen password
REGISTER_INVITE_CODE // shared code required by POST /api/register; unset = registration closed

// auth: the UI keeps the access token in memory and gets a new one from an httpOnly refresh cookie
TOKEN_TTL // optional, access token lifetime, default 15m
REFRESH_TOKEN_TTL // optional, refresh cookie lifetime = longest login without a password, default 168h
CORS_ALLOWED_ORIGINS // optional, comma-separated UI origins (exact, no "*"), default http://localhost:4200
COOKIE_SECURE // default true; set false for plain-HTTP local dev (Safari will not store a Secure cookie on http)
COOKIE_SAMESITE // lax (default), strict or none; none (UI and API on different sites) requires COOKIE_SECURE=true

// for database
DB_NAME 
DB_HOST
DB_PORT
DB_USER
DB_PASSWORD 

PORT // server port

